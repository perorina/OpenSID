YMS_API_ADDR=127.0.0.1:8090
# Pilih salah satu:
# 1. Lokal OpenSID: jalankan scripts/run-local.ps1 agar YMS_DB_CONFIG_JSON dibuat dari desa/config/database.php.
# 2. Server/manual: set YMS_DB_DSN sendiri di environment, jangan commit credential asli.
# YMS_DB_DSN=opensid_user:opensid_password@tcp(127.0.0.1:3307)/opensid_local?parseTime=true&charset=utf8mb4
YMS_CONFIG_ID=1
YMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
YMS_INTERNAL_API_KEY=dev-internal-key
YMS_JWT_SECRET=dev-change-me
YMS_COOKIE_SECURE=false
YMS_OPENSID_BASE_URL=http://127.0.0.1:8081
# Khusus development PPID. Jangan aktifkan di production.
YMS_ENABLE_SAMPLE_DATA=false
# Path relatif terhadap services/yamansari-api ketika memakai helper lokal.
YMS_PPID_SAMPLE_PDF_DIR=../../output/pdf/ppid
YMS_DIP_SAMPLE_PDF_DIR=../../output/pdf/ppid/dip
YMS_OPENSID_DOCUMENT_DIR=../../desa/upload/dokumen
